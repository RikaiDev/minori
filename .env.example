# minori 環境變數設定

# 伺服器設定
PORT=3000
NODE_ENV=development

# LINE Bot 設定
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# 中央氣象署 API (選填)
CWA_API_KEY=your_cwa_api_key_here

# Database (Neon PostgreSQL - required for production)
# Get your connection string from https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# ============================================
# Deployment (Render + Neon)
# ============================================
# These are only needed for GitHub Actions deployment
# Configure in GitHub repository secrets

# Render deploy hook URL (Settings > Deploy Hook in Render dashboard)
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxx

# Staging/Production URLs for health checks
# STAGING_URL=https://minori-api.onrender.com
# PRODUCTION_URL=https://minori-api-prod.onrender.com
